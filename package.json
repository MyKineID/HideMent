{
  "name": "hidement",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "HideMent (Hide Comment): ekstensi browser untuk mendeteksi & menyembunyikan komentar berbahaya berbahasa Indonesia (judol, link phising, toxic)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MyKineID/HideMent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "eval": "tsx research/eval.ts",
    "label": "tsx research/label.ts",
    "bench": "tsx research/bench.ts"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
